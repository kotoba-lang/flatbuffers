;; Honest Kotoba v1: FlatBuffers file identification only.
;; Kotoba CLI 0.7.2 / wasm32-kotoba-v1 / i64-v1. No FFI. No IEEE floats.
;; No schema compiler, table/vtable walk, vectors, or JSON.
;;
;; Vendored fixture (fixtures/tiny-size-prefixed.bin, 12 bytes, little-endian):
;;   08 00 00 00  04 00 00 00  4d 59 46 49
;;   size-prefix u32 = 8 | root uoffset = 4 (not walked) | identifier MYFI
;; Identifier at offset 8 because the fixture is size-prefixed
;; (GetBufferIdentifier(buf, size_prefixed=true) = buf + 8).

(ns flatbuffers.file-id
  (:export [u32-le file-id-offset identifier-b0 identifier-b1 identifier-b2 identifier-b3 size-prefix-u32 main]))

(defn fixture-byte [i]
  (if (= i 0) 8
    (if (= i 1) 0
      (if (= i 2) 0
        (if (= i 3) 0
          (if (= i 4) 4
            (if (= i 5) 0
              (if (= i 6) 0
                (if (= i 7) 0
                  (if (= i 8) 77
                    (if (= i 9) 89
                      (if (= i 10) 70
                        (if (= i 11) 73
                          0)))))))))))))

(defn u32-le [b0 b1 b2 b3]
  (+ b0 (* b1 256) (* b2 65536) (* b3 16777216)))

(defn file-id-offset [size-prefixed]
  (if (zero? size-prefixed) 4 8))

(defn identifier-b0 []
  (fixture-byte (file-id-offset 1)))

(defn identifier-b1 []
  (fixture-byte (+ (file-id-offset 1) 1)))

(defn identifier-b2 []
  (fixture-byte (+ (file-id-offset 1) 2)))

(defn identifier-b3 []
  (fixture-byte (+ (file-id-offset 1) 3)))

(defn size-prefix-u32 []
  (u32-le (fixture-byte 0) (fixture-byte 1) (fixture-byte 2) (fixture-byte 3)))

(defn main []
  (size-prefix-u32))
